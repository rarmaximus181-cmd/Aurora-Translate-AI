<Window x:Class="AuroraTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Translate" Width="1280" Height="850" MinWidth="1000" MinHeight="720"
        Background="#0A101B" Foreground="#F4F5FC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#8296FF"/>
        <SolidColorBrush x:Key="AccentBright" Color="#BEC9FF"/>
        <SolidColorBrush x:Key="Muted" Color="#91A0B6"/>
        <SolidColorBrush x:Key="Card" Color="#F1121B2A"/>
        <SolidColorBrush x:Key="Line" Color="#29364A"/>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#435672" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#718AB1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8296FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9ECF8"/></Style>
        <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="#29364A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9ECF8"/><Setter Property="Background" Value="#1A2639"/><Setter Property="BorderBrush" Value="#344258"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="#0D1221"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,14"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#F00D1524"/><Setter Property="Foreground" Value="#EFF2FD"/><Setter Property="CaretBrush" Value="#A6B8FF"/><Setter Property="BorderBrush" Value="#31405A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,12"/><Setter Property="SelectionBrush" Value="#465C94"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101A2B"/><Setter Property="Foreground" Value="#EFF2FD"/><Setter Property="BorderBrush" Value="#31405A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderThickness="0"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="#3A4B69" BorderThickness="1" CornerRadius="9"><TextBlock Text="⌄" Foreground="#B5C4DF" Margin="0,0,14,3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="14,11,40,11" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade"><Border Background="#111D30" BorderBrush="#40516C" BorderThickness="1" CornerRadius="9" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter Margin="4" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EFF2FD"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#31405D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2B3D64"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD8EB"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="SwitchTrack" Width="30" Height="17" CornerRadius="9" Background="#27364E" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse x:Name="SwitchDot" Width="11" Height="11" Fill="#A9BEDA" HorizontalAlignment="Left" Margin="3,0,0,0"/></Border>
                    <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#768DEC"/><Setter TargetName="SwitchDot" Property="Fill" Value="#F1F5FF"/><Setter TargetName="SwitchDot" Property="Margin" Value="16,0,0,0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid x:Name="Backdrop" IsHitTestVisible="False">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="GradientA" Color="#080F20" Offset="0"/><GradientStop x:Name="GradientB" Color="#241638" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Canvas>
                <Ellipse x:Name="OrbOne" Width="600" Height="600" Canvas.Left="600" Canvas.Top="-280" Opacity="0.18"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#9370DB" Offset="0"/><GradientStop Color="#009370DB" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="OrbOneMotion"/></Ellipse.RenderTransform></Ellipse>
                <Ellipse x:Name="OrbTwo" Width="750" Height="750" Canvas.Left="420" Canvas.Top="250" Opacity="0.13"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#37DDCE" Offset="0"/><GradientStop Color="#0037DDCE" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="OrbTwoMotion"/></Ellipse.RenderTransform></Ellipse>
                <Ellipse x:Name="OrbThree" Width="470" Height="470" Canvas.Left="900" Canvas.Top="120" Opacity="0.09"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#BC76E6" Offset="0"/><GradientStop Color="#00BC76E6" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="OrbThreeMotion"/></Ellipse.RenderTransform></Ellipse>
            </Canvas>
            <Image x:Name="CustomBackgroundImage" Stretch="UniformToFill" Opacity="0.4"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#F70D1522" BorderBrush="#263348" BorderThickness="0,0,1,0" Padding="18,26,18,20">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="37" Height="37" Background="#1E2B4D" CornerRadius="11" HorizontalAlignment="Left"><Path Data="M 8,27 L 19,7 L 30,27 M 13,20 L 25,20" Stroke="#A7B5FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="21" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Aurora" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="AI WORKSPACE" FontSize="8" Foreground="#7E8FAA" Margin="0,2,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="SemiBold" Foreground="#64768F" Margin="15,34,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <Button x:Name="TranslateNav" Style="{StaticResource NavButton}" Tag="translate" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C1;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0" FontSize="18"/><TextBlock Text="Translate"/></StackPanel></Button>
                        <Button x:Name="ChatNav" Style="{StaticResource NavButton}" Tag="chat" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0" FontSize="18"/><TextBlock Text="Conversation"/></StackPanel></Button>
                        <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Tag="history" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0" FontSize="18"/><TextBlock Text="History"/></StackPanel></Button>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0" FontSize="18"/><TextBlock Text="Settings"/></StackPanel></Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2"><Border Background="#122239" CornerRadius="12" Padding="13"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#70E3CB" Margin="0,0,7,0"/><TextBlock Text="Local AI workspace" FontSize="11" Foreground="#C0D7DD"/></StackPanel><TextBlock Text="Private conversation · no key" FontSize="10" Foreground="#869BB5" Margin="14,5,0,0"/></StackPanel></Border><Button x:Name="AccountButton" Click="Account_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="2,16,2,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="#363052" HorizontalAlignment="Left"><Grid>
                                <TextBlock x:Name="AccountInitial" Text="A" FontSize="17" Foreground="#D8C8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AccountAvatarImage" Width="38" Height="38" Stretch="UniformToFill" Visibility="Collapsed"><Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip></Image>
                            </Grid></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="AccountName" Text="Guest" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountSubtitle" Text="Discord account in Settings" FontSize="10" Foreground="#869BB5" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Button></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="32,27,32,17">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="PageEyebrow" Text="WORKSPACE / TRANSLATE" FontSize="9" Foreground="#6F839F" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Translate" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="PageSubtitle" Text="Clear communication, in any language." Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
                    <Border Grid.Column="1" CornerRadius="7" Background="#172438" BorderBrush="#2B3D54" BorderThickness="1" Padding="11,8" VerticalAlignment="Top" Margin="16,12,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#69D7C3" Margin="0,0,7,0"/><TextBlock Text="LOCAL-FIRST" FontSize="9" Foreground="#A7C9D1" FontWeight="SemiBold"/></StackPanel></Border>
                </Grid>
                <Grid x:Name="TranslatePage" Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FROM" FontSize="10" Foreground="#8D9CB8" Margin="0,0,0,8"/><ComboBox x:Name="SourceLanguageBox" SelectionChanged="Language_Changed"/></StackPanel><Button Grid.Column="1" Content="⇄" FontSize="22" ToolTip="Swap languages and text" Click="Swap_Click" Padding="0" Width="40" Height="42" VerticalAlignment="Bottom"/><StackPanel Grid.Column="2"><TextBlock Text="TO" FontSize="10" Foreground="#8D9CB8" Margin="0,0,0,8"/><ComboBox x:Name="TargetLanguageBox" SelectionChanged="Language_Changed"/></StackPanel></Grid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="SOURCE TEXT" Foreground="#9CAAC4" FontSize="10" FontWeight="SemiBold"/><Button Content="Clear" Style="{StaticResource SmallButton}" Background="Transparent" BorderThickness="0" Padding="4,0" HorizontalAlignment="Right" Click="ClearSource_Click"/></Grid><Grid Grid.Row="1" Margin="0,20,0,16"><TextBox x:Name="SourceText" Background="Transparent" BorderThickness="0" Padding="0" FontSize="20" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="10000" TextChanged="Source_TextChanged" PreviewKeyDown="Source_KeyDown"/><TextBlock x:Name="SourcePlaceholder" Text="Enter text to translate" FontSize="18" Foreground="#64738D" LineHeight="32" IsHitTestVisible="False"/></Grid><Grid Grid.Row="2"><Button x:Name="TranslateMicButton" Content="Speak" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Click="TranslateMic_Click" ToolTip="Dictate one phrase using an installed Windows speech language"/><TextBlock x:Name="SourceCount" Text="0 / 10,000" Foreground="#8191AF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#475B8D" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="TRANSLATION" Foreground="{DynamicResource AccentBright}" FontSize="10" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,20,0,16"><TextBox x:Name="ResultText" Background="Transparent" BorderThickness="0" Padding="0" FontSize="20" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/><TextBlock x:Name="ResultPlaceholder" Text="Your translation appears here" FontSize="18" Foreground="#64738D" LineHeight="32" IsHitTestVisible="False"/></Grid><StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="SpeakResultButton" Content="♪  Listen" Style="{StaticResource SmallButton}" Click="SpeakResult_Click" IsEnabled="False"/><Button x:Name="CopyResultButton" Content="Copy" Style="{StaticResource SmallButton}" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" Click="CopyResult_Click" IsEnabled="False"/></StackPanel></Grid></Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TranslationEngineLabel" Text="Free online translation" Foreground="#BED3DE" FontSize="11"/><TextBlock Text="Ctrl + Enter to translate" Foreground="#8090AE" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button x:Name="CancelTranslateButton" Grid.Column="1" Content="Cancel" Margin="0,0,12,0" Click="Cancel_Click" Visibility="Collapsed"/><Button x:Name="TranslateButton" Grid.Column="2" Content="Translate  →" Style="{StaticResource PrimaryButton}" Padding="27,14" Click="Translate_Click"/></Grid>
                </Grid>
                <Grid x:Name="ChatPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#C8121D2D" BorderBrush="#2B3A50" BorderThickness="1" CornerRadius="11" Padding="13,11" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="162"/><ColumnDefinition Width="142"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="MODEL" FontSize="9" Foreground="#768AA6" Margin="1,0,0,6"/><ComboBox x:Name="ChatModelBox" SelectionChanged="ChatModel_Changed" MinWidth="145"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="LANGUAGE" FontSize="9" Foreground="#768AA6" Margin="1,0,0,6"/><ComboBox x:Name="ConversationLanguageBox" SelectionChanged="ConversationLanguage_Changed"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="RESPONSE" FontSize="9" Foreground="#768AA6" Margin="1,0,0,6"/><ComboBox x:Name="ResponseStyleBox" SelectionChanged="ResponseStyle_Changed"><ComboBoxItem Content="Concise" Tag="concise"/><ComboBoxItem Content="Balanced" Tag="balanced"/><ComboBoxItem Content="Detailed" Tag="detailed"/></ComboBox></StackPanel>
                            <Button x:Name="NewChatButton" Grid.Column="3" Content="New chat" Style="{StaticResource SmallButton}" VerticalAlignment="Bottom" Height="41" Click="NewChat_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Expander x:Name="AdvancedExpander" Foreground="#AEBED4" FontSize="11" Header="Advanced conversation controls" IsExpanded="False" Padding="4,0">
                            <Border Background="#141E2F" BorderBrush="#2D3B50" BorderThickness="1" CornerRadius="9" Padding="14,7" Margin="0,11,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ReasoningCheck" Content="Careful reasoning · allow more time for complex questions" Checked="ConversationOptions_Changed" Unchecked="ConversationOptions_Changed"/>
                                    <CheckBox x:Name="TrollModeCheck" Content="Troll display · joke text only" Checked="ConversationOptions_Changed" Unchecked="ConversationOptions_Changed"/>
                                    <TextBlock Text="The joke display changes only the literal phrase “this is not allowed” to “this is allowed”. Original answers, spoken replies, and model context stay unchanged." FontSize="10" Foreground="#8295AF" TextWrapping="Wrap" Margin="20,0,0,7"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Border x:Name="TrollModeBanner" Visibility="Collapsed" Background="#28231B" BorderBrush="#5B5034" BorderThickness="1" CornerRadius="7" Padding="11,8" Margin="0,10,0,0"><TextBlock Text="Troll display is on · a joke presentation only. Original model answers remain available." Foreground="#D9C799" FontSize="10" TextWrapping="Wrap"/></Border>
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Background="#E60F1827">
                        <Grid>
                            <ScrollViewer x:Name="ChatScroll" Padding="23,23,23,7"><StackPanel x:Name="ChatMessagesPanel"/></ScrollViewer>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Visibility="{Binding Visibility, ElementName=ChatWelcome}"><StackPanel x:Name="ChatWelcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="570" Margin="30,20">
                                <Border Width="52" Height="52" CornerRadius="15" Background="#1D2C49" BorderBrush="#354B75" BorderThickness="1" HorizontalAlignment="Center"><Path Data="M 8,27 L 19,7 L 30,27 M 13,20 L 25,20" Stroke="#A7B5FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="25" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="What can we work on?" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Margin="0,19,0,8"/>
                                <TextBlock Text="Write with clarity. Explore an idea. Learn something new." Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center"/>
                                <UniformGrid Columns="2" Margin="0,22,0,0">
                                    <Button HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,8,8" Tag="Help me write a clear, professional email. Ask me about the recipient and what I want to say." Click="Suggestion_Click"><StackPanel><TextBlock Text="Write &amp; refine" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Turn a rough draft into clear writing" Foreground="#8298B5" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
                                    <Button HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,0,8" Tag="Explain a complex topic simply. Ask me what topic I want to understand, then use an example." Click="Suggestion_Click"><StackPanel><TextBlock Text="Understand an idea" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Get an explanation that clicks" Foreground="#8298B5" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
                                    <Button HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,8,0" Tag="Help me practice a conversation in the selected language. Start with a friendly question and gently correct my mistakes." Click="Suggestion_Click"><StackPanel><TextBlock Text="Practice a language" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Build confidence, one conversation at a time" Foreground="#8298B5" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
                                    <Button HorizontalContentAlignment="Left" Padding="15,12" Tag="Help me plan a project. Ask me about my goal, deadline, and constraints, then suggest a practical first step." Click="Suggestion_Click"><StackPanel><TextBlock Text="Make a plan" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Find a practical next step" Foreground="#8298B5" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
                                </UniformGrid>
                                <TextBlock x:Name="ChatSetupHint" Text="Checking your local model…" Foreground="#68809F" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,0"/>
                            </StackPanel></ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Background="#152034" BorderBrush="#405477" BorderThickness="1" CornerRadius="12" Padding="16,12,13,9" Margin="0,14,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><TextBox x:Name="ChatInput" MaxLength="4000" MinHeight="36" MaxHeight="85" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged" ToolTip="Enter to send; Shift + Enter for a new line" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"/><TextBlock x:Name="ChatInputPlaceholder" Text="Message Aurora…" Foreground="#758BA9" FontSize="14" IsHitTestVisible="False" Margin="0,3,0,0"/></Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ChatModelLabel" Text="Local conversation" Foreground="#7990B0" FontSize="9"/><TextBlock Text="Enter to send · Shift + Enter for a new line" Foreground="#5E7798" FontSize="9" Margin="0,3,0,0"/></StackPanel><Button x:Name="ChatMicButton" Grid.Column="1" Content="Speak" Style="{StaticResource SmallButton}" Background="#1D2B42" Margin="10,0,0,0" ToolTip="Speak a message, then send it automatically" Click="ChatMic_Click"/><Button x:Name="SendChatButton" Grid.Column="2" Content="Send  ↑" Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="9,0,0,0" Click="SendChat_Click"/></Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,17"><TextBlock x:Name="HistoryCount" Text="Your recent translations" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button Content="Clear history" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Click="ClearHistory_Click"/></Grid><ScrollViewer Grid.Row="1"><StackPanel x:Name="HistoryPanel"/><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style></ScrollViewer.Style></ScrollViewer></Grid>
                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Padding="0,0,7,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose a mood, or bring your own PNG or animated GIF." Style="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,17"/>
                            <UniformGrid Columns="4"><Button Tag="Aurora" Click="Theme_Click" Margin="0,0,9,0" Padding="0" Height="88" BorderBrush="#7C6EA6"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#292F64"/><GradientStop Color="#164942" Offset="1"/></LinearGradientBrush></Button.Background><StackPanel><TextBlock Text="✦" FontSize="23" HorizontalAlignment="Center" Foreground="#D7CDFF"/><TextBlock Text="Aurora" Margin="0,7,0,0"/></StackPanel></Button><Button Tag="Nebula" Click="Theme_Click" Margin="0,0,9,0" Padding="0" Height="88"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#572053"/><GradientStop Color="#272C5A" Offset="1"/></LinearGradientBrush></Button.Background><StackPanel><TextBlock Text="✧" FontSize="23" HorizontalAlignment="Center" Foreground="#F3B5DD"/><TextBlock Text="Nebula" Margin="0,7,0,0"/></StackPanel></Button><Button Tag="Ocean" Click="Theme_Click" Margin="0,0,9,0" Padding="0" Height="88"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#143C62"/><GradientStop Color="#15575D" Offset="1"/></LinearGradientBrush></Button.Background><StackPanel><TextBlock Text="≈" FontSize="23" HorizontalAlignment="Center" Foreground="#9DECE8"/><TextBlock Text="Ocean" Margin="0,7,0,0"/></StackPanel></Button><Button Tag="Sunset" Click="Theme_Click" Padding="0" Height="88"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#59353A"/><GradientStop Color="#503459" Offset="1"/></LinearGradientBrush></Button.Background><StackPanel><TextBlock Text="☼" FontSize="23" HorizontalAlignment="Center" Foreground="#FFD2A4"/><TextBlock Text="Sunset" Margin="0,7,0,0"/></StackPanel></Button></UniformGrid>
                            <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ThemeLabel" Text="Current theme: Aurora" Foreground="#BBC7DE" FontSize="11"/><TextBlock x:Name="BackgroundFileLabel" Text="No custom background imported" FontSize="10" Foreground="#8798B4" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Import background" Style="{StaticResource SmallButton}" Click="ImportBackground_Click"/><Button Content="Use imported" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="UseCustom_Click"/></StackPanel></Grid>
                            <CheckBox x:Name="AnimateThemeCheck" Content="Animate themes and GIF backgrounds" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,17,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background visibility" FontSize="12" Foreground="#ACBBD2" VerticalAlignment="Center"/><Slider x:Name="BackgroundOpacitySlider" Grid.Column="1" Minimum="0.1" Maximum="0.8" ValueChanged="Opacity_Changed" Margin="0,8,0,0"/></Grid>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Translation &amp; local AI" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Online translation works immediately. Local translation and AI conversation use an Ollama model on this computer." Style="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,17"/>
                            <TextBlock Text="Translation engine" Foreground="#B3C2DC" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="EngineBox" SelectionChanged="Engine_Changed"><ComboBoxItem Content="Free online · MyMemory" Tag="online"/><ComboBoxItem Content="Local AI · Ollama" Tag="local"/></ComboBox><TextBlock Text="Online text is sent to MyMemory. Public quota: about 5,000 characters per day; results depend on the language pair. Use local mode for private or offline translation." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,18"/>
                            <TextBlock Text="Ollama model" Foreground="#B3C2DC" FontSize="12" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ModelTextBox" TextChanged="Model_Changed" Padding="12,10"/><Button Grid.Column="1" Content="Refresh models" Style="{StaticResource SmallButton}" Margin="9,0,0,0" Click="RefreshModels_Click"/><Button Grid.Column="2" x:Name="DownloadModelButton" Content="Download model" Style="{StaticResource SmallButton}" Margin="9,0,0,0" Click="DownloadModel_Click"/></Grid><ComboBox x:Name="InstalledModelsBox" Margin="0,10,0,0" SelectionChanged="InstalledModel_Changed" Visibility="Collapsed"/><TextBlock x:Name="ModelsStatus" Text="Recommended for this computer: qwen3.5:4b. Smaller fallback: qwen2.5:1.5b." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/><Button Content="Install Ollama ↗" Style="{StaticResource SmallButton}" Margin="0,13,0,0" HorizontalAlignment="Left" Click="InstallOllama_Click"/>
                        </StackPanel></Border>
                        <Border x:Name="VoiceCard" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Voice &amp; audio" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Pick a Windows voice or add a natural voice model. The same voice reads translations and speaks your AI replies." Style="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,17"/>
                                <TextBlock Text="Speaking voice · language must match" Foreground="#B3C2DC" FontSize="12" Margin="0,0,0,8"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="VoiceBox" SelectionChanged="Voice_Changed"/>
                                    <Button x:Name="PreviewVoiceButton" Grid.Column="1" Content="♪ Preview voice" Style="{StaticResource SmallButton}" Margin="9,0,0,0" Click="PreviewVoice_Click"/>
                                </Grid>
                                <Border Background="#152236" CornerRadius="12" Padding="16" Margin="0,19,0,6">
                                    <StackPanel>
                                        <TextBlock Text="OFFLINE VOICE LIBRARY" FontSize="10" Foreground="#ACBCED" FontWeight="SemiBold"/>
                                        <TextBlock Text="Download once. Speak offline. No API key." Foreground="#91A8C4" FontSize="11" Margin="0,7,0,12"/>
                                        <ComboBox x:Name="VoiceCatalogBox"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="DownloadVoiceButton" Content="Download selected voice" Style="{StaticResource PrimaryButton}" Padding="13,8" Click="DownloadVoice_Click" Margin="0,0,8,8"/>
                                            <Button x:Name="ImportVoiceButton" Content="Import voice model" Style="{StaticResource SmallButton}" Click="ImportVoice_Click" Margin="0,0,8,8"/>
                                            <Button Content="Voice info ↗" Style="{StaticResource SmallButton}" Click="VoiceInfo_Click" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <TextBlock Text="Use a Piper .onnx voice model and its matching .onnx.json configuration. Each voice has its own usage terms; see Voice info." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="VoiceLibraryStatus" Text="Downloaded and imported voices appear in your speaking voice list above." Foreground="#AFC7D6" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Installed voice models" Foreground="#B3C2DC" FontSize="12" Margin="0,12,0,8"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ImportedVoicesBox"/>
                                    <Button x:Name="RemoveVoiceButton" Grid.Column="1" Content="Remove" Style="{StaticResource SmallButton}" Margin="9,0,0,0" Click="RemoveVoice_Click"/>
                                </Grid>
                                <CheckBox x:Name="SpeakTranslationsCheck" Content="Read translations aloud automatically" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,16,0,8"/>
                                <CheckBox x:Name="SpeakChatCheck" Content="Read AI replies aloud automatically" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Speaking speed" FontSize="12" Foreground="#ACBBD2" VerticalAlignment="Center"/><Slider x:Name="SpeechRateSlider" Grid.Column="1" Minimum="-5" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeechRate_Changed"/></Grid>
                                <TextBlock x:Name="RecognitionStatus" Style="{StaticResource MutedText}" FontSize="11" Margin="0,16,0,0"/>
                                <Button Content="Windows speech settings ↗" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,13,0,0" Click="WindowsSpeech_Click"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DiscordCard" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Discord account" FontSize="20" FontWeight="SemiBold"/>
                                <Grid Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="29" Background="#363052" HorizontalAlignment="Left">
                                        <Grid><TextBlock x:Name="DiscordInitial" Text="A" FontSize="25" Foreground="#D8C8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="DiscordAvatarImage" Width="58" Height="58" Stretch="UniformToFill" Visibility="Collapsed"><Image.Clip><EllipseGeometry Center="29,29" RadiusX="29" RadiusY="29"/></Image.Clip></Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DiscordProfileName" Text="Your Discord profile" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DiscordProfileUsername" Text="Your avatar appears here after sign-in." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                </Grid>
                                <TextBlock x:Name="DiscordStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,15"/>
                                <Border Background="#152236" CornerRadius="12" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="ONE-TIME DISCORD SETUP" FontSize="10" Foreground="#ACBCED" FontWeight="SemiBold"/>
                                        <TextBlock Text="1. Create an application in the Discord Developer Portal. Copy its Application ID." Style="{StaticResource MutedText}" FontSize="11" Margin="0,11,0,7"/>
                                        <TextBlock Text="2. Under OAuth2, enable Public Client. Add this exact redirect URI:" Style="{StaticResource MutedText}" FontSize="11"/>
                                        <TextBox Text="http://127.0.0.1:43821/callback" IsReadOnly="True" FontSize="12" Padding="11,8" Margin="0,9,0,9"/>
                                        <TextBlock Text="3. Paste the Application ID below and save it. Then sign in in your browser." Style="{StaticResource MutedText}" FontSize="11"/>
                                        <TextBlock Text="Application ID" Foreground="#B3C2DC" FontSize="12" Margin="0,15,0,8"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DiscordClientIdBox" MaxLength="20" Padding="12,10" ToolTip="The numeric Application ID from your Discord developer application"/><Button Grid.Column="1" Content="Save ID" Style="{StaticResource SmallButton}" Margin="9,0,0,0" Click="SaveDiscord_Click"/></Grid>
                                        <Button Content="Open Discord Developer Portal ↗" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="DiscordHelp_Click"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,17,0,8"><Button x:Name="DiscordSignInButton" Content="Sign in with Discord" Style="{StaticResource PrimaryButton}" Padding="13,8" Margin="0,0,8,0" Click="DiscordSignIn_Click"/><Button x:Name="DiscordSignOutButton" Content="Sign out" Style="{StaticResource SmallButton}" Visibility="Collapsed" Click="DiscordSignOut_Click"/></WrapPanel>
                                <TextBlock Text="No password, Discord user token, bot token, or client secret is entered into Aurora. Sign-in reads your Discord name and avatar only; it does not sync your content." Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="UpdatesCard" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <Grid><TextBlock Text="Application updates" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="UpdateVersionText" Text="Version" Foreground="#91A9CA" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                <TextBlock Text="Aurora checks GitHub releases when it opens. When a newer published version exists, updating is required before entering the workspace." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,16"/>
                                <TextBlock Text="GitHub release repository" Foreground="#B3C2DC" FontSize="12" Margin="0,0,0,8"/>
                                <TextBox x:Name="UpdateRepositoryBox" IsReadOnly="True" Padding="12,10"/>
                                <TextBlock x:Name="UpdateStatusText" Text="Checks use published releases from the configured repository." Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,12"/>
                                <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource SmallButton}" Click="CheckUpdates_Click" Margin="0,0,9,0"/><Button Content="View releases ↗" Style="{StaticResource SmallButton}" Click="OpenReleases_Click"/></WrapPanel>
                            </StackPanel>
                        </Border>                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="History &amp; privacy" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="SaveHistoryCheck" Content="Save translations on this computer" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,17,0,9"/><TextBlock Text="Chat messages stay in memory for this session. Discord sign-in does not sync your content. Backgrounds and settings are stored in your Windows user profile." Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#B2101927" BorderBrush="#27354A" BorderThickness="0,1,0,0" CornerRadius="0" Padding="5,10" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="#9CB3CE" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="GlobalCancelButton" Content="Cancel" Style="{StaticResource SmallButton}" Padding="8,3" Visibility="Collapsed" Click="Cancel_Click"/><Button Content="Stop voice" Style="{StaticResource SmallButton}" Background="Transparent" BorderThickness="0" Padding="8,3" Click="StopVoice_Click"/></StackPanel></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
