<Window x:Class="AuroraTranslate.UpdateRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Aurora Translate" Width="650" Height="625" MinWidth="580" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#090D19" Foreground="#F4F5FC"
        FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9ECF8"/><Setter Property="Background" Value="#202C44"/>
            <Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D1428" Offset="0"/><GradientStop Color="#201636" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="AURORA TRANSLATE" Foreground="#BFAAFF" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Text="A new Aurora is ready." FontSize="30" FontWeight="SemiBold" Margin="0,13,0,9"/>
                <TextBlock x:Name="RequirementText" Foreground="#AAB8D2" TextWrapping="Wrap" LineHeight="22"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#341A2540" BorderBrush="#414365" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,22,0,20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="INSTALLED" Foreground="#98A9C8" FontSize="10"/><TextBlock x:Name="CurrentVersionText" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="REQUIRED UPDATE" Foreground="#CBB9FF" FontSize="10"/><TextBlock x:Name="NewVersionText" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="#CBB9FF"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="#CC111A2B" BorderBrush="#2D3A52" BorderThickness="1" CornerRadius="11" Padding="18">
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="WHAT'S NEW" FontSize="11" FontWeight="SemiBold" Foreground="#B6C2D8" Margin="0,0,0,11"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ReleaseNotesText" Foreground="#DBE1F1" TextWrapping="Wrap" LineHeight="22"/></ScrollViewer>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,20,0,18">
                <ProgressBar x:Name="DownloadProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#A78BFA" Background="#253148" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" Text="The download will be verified before installation." Foreground="#9CADC7" TextWrapping="Wrap" LineHeight="20" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ExitButton" Content="Exit app" Click="Exit_Click"/>
                <Button x:Name="InstallButton" Grid.Column="2" Content="Install update &amp; restart" Background="#A78BFA" Foreground="#0D1221" FontWeight="SemiBold" Click="Install_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
