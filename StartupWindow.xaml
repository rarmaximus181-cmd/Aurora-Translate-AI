<Window x:Class="AuroraTranslate.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting Aurora" Width="900" Height="550" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" Foreground="#EAF0FC" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing">
    <Border CornerRadius="20" Background="#0B1220" BorderBrush="#30405A" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D1727" Offset="0"/><GradientStop Color="#111E33" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="780" Height="780" Canvas.Left="310" Canvas.Top="-470" Opacity="0.14"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7C95F6" Offset="0"/><GradientStop Color="#007C95F6" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Ellipse Width="720" Height="720" Canvas.Left="-450" Canvas.Top="130" Opacity="0.10"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#48CFCA" Offset="0"/><GradientStop Color="#0048CFCA" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
            </Canvas>
            <Button Content="×" Foreground="#778BAA" FontSize="24" Background="Transparent" BorderThickness="0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0" Click="Close_Click" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template></Button>
            <StackPanel x:Name="RevealPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-15,0,0" Opacity="0">
                <StackPanel.RenderTransform><TranslateTransform x:Name="RevealMotion" Y="12"/></StackPanel.RenderTransform>
                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                    <Ellipse x:Name="MarkGlow" Width="130" Height="130" Opacity="0.5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#557CA1FF" Offset="0"/><GradientStop Color="#007CA1FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                    <Ellipse Width="124" Height="124" Stroke="#243B5D" StrokeThickness="1"/>
                    <Path Data="M 70,8 A 62,62 0 0 1 129,88" Stroke="#8298F0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.RenderTransform><RotateTransform x:Name="OuterRingRotation" CenterX="70" CenterY="70"/></Path.RenderTransform></Path>
                    <Path Data="M 31,36 A 47,47 0 0 1 114,85" Stroke="#58C9C5" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.RenderTransform><RotateTransform x:Name="InnerRingRotation" CenterX="70" CenterY="70"/></Path.RenderTransform></Path>
                    <Border Width="73" Height="73" CornerRadius="22" Background="#1B2B49" BorderBrush="#3B5280" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 8,27 L 19,7 L 30,27 M 13,20 L 25,20" Stroke="#B6C5FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="33" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock Text="Aurora" FontSize="43" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,19,0,0"/>
                <TextBlock Text="YOUR LOCAL AI WORKSPACE" FontSize="10" Foreground="#8DA4C5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,11,0,0"/>
                <TextBlock x:Name="StartupStatus" Text="Preparing your workspace" FontSize="12" Foreground="#768CAC" HorizontalAlignment="Center" Margin="0,35,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="610"/>
                <Border Height="2" Width="138" Background="#1E304C" CornerRadius="1" Margin="0,17,0,0" ClipToBounds="True"><Border x:Name="ProgressSweep" Width="45" Background="#799AF3" HorizontalAlignment="Left"><Border.RenderTransform><TranslateTransform x:Name="SweepMotion" X="-45"/></Border.RenderTransform></Border></Border>
            </StackPanel>
            <Grid VerticalAlignment="Bottom" Margin="30,0,30,22"><TextBlock Text="TRANSLATE · THINK · CREATE" Foreground="#405A7B" FontSize="9"/><TextBlock Text="Private by design" Foreground="#496382" FontSize="9" HorizontalAlignment="Right"/></Grid>
        </Grid>
    </Border>
</Window>
